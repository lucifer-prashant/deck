{
  "name": "deck",
  "version": "0.4.0",
  "description": "Spatial workspace for code — infinite canvas with terminals, editors, browsers, notes, git, and docking.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "ide",
    "spatial",
    "workspace",
    "terminal",
    "canvas",
    "developer-tools",
    "fedora"
  ],
  "author": {
    "name": "lucifer-prashant",
    "email": "22051530@kiit.ac.in"
  },
  "homepage": "https://github.com/lucifer-prashant/deck",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.45.0",
    "node-pty": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.lucifer-prashant.deck",
    "productName": "Deck",
    "icon": "build/icons",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ],
      "category": "Development",
      "maintainer": "lucifer-prashant <22051530@kiit.ac.in>",
      "icon": "build/icons"
    }
  }
}
